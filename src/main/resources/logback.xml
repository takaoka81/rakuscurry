<?xml version="1.0" encoding="UTF-8"?>
<configuration>
<!-- Appenderの定義：ログの出⼒先を設定 -->
<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
<!-- ログファイルの出⼒先を指定 -->
<file>logs/batch.log</file>
<!-- ログファイルのローテーション（切り替え）⽅法を定義 -->
<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
<fileNamePattern>logs/batch.%d{yyyy-MM-dd}.log</fileNamePattern>
<maxHistory>30</maxHistory>
</rollingPolicy>
<!-- Encoderの設定：ログのフォーマットを定義 -->
<encoder>
<pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger -
%msg%n</pattern>
</encoder>
</appender>
<!-- メール送信⽤Appenderの定義：ERRORレベルのログをメールで送信 -->
<appender name="EMAIL" class="ch.qos.logback.classic.net.SMTPAppender">
<!-- SMTPサーバーの設定 -->
<smtpHost>localhost</smtpHost>
<smtpPort>1025</smtpPort>
<!-- Mailpitは認証不要のため、username/passwordは設定しない -->
<!-- SSL/TLSの使⽤ -->
<SSL>false</SSL>
<STARTTLS>false</STARTTLS>
<!-- メール設定 -->
<from>batch-system@example.com</from>
<to>admin@example.com</to>
<to>operator@example.com</to>
<subject>【バッチ処理】エラーが発⽣しました</subject>
<!-- メール送信のトリガー：ERRORレベルのログが発⽣した場合にメール送信 -->
<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
<level>ERROR</level>
</filter>
<evaluator class="ch.qos.logback.classic.boolex.OnErrorEvaluator"/>
<asynchronousSending>false</asynchronousSending>
<!-- メール本⽂のフォーマット -->
<layout class="ch.qos.logback.classic.PatternLayout">
<pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger -
%msg%n</pattern>
</layout>
</appender>
<!-- Root Loggerの設定 -->
<root level="INFO">
<!-- 使⽤するAppenderを参照（FILEとEMAILの両⽅を使⽤） -->
<appender-ref ref="FILE"/>
<appender-ref ref="EMAIL"/>
</root>
</configuration>
